# Copy to .env.local and fill in.

GEMINI_API_KEY=

# --- Recent Sermons -----------------------------------------------------------
# Both OPTIONAL — read from the environment by scripts/fetch-sermons.mjs, never
# shipped to the browser. Set them in your shell (the script doesn't load this
# file). See the README.
#
# A YouTube Data API v3 key. Not needed today; it lets the script read the
# Sermons playlist once it grows past 100 videos. For the daily job, add it as a
# GitHub repository secret named YOUTUBE_API_KEY instead.
YOUTUBE_API_KEY=

# Override the playlist to read (defaults to the Sermons playlist, PLN4ec_iMN-G0).
SERMONS_PLAYLIST_ID=
