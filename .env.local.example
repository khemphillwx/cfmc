# Copy to .env.local and fill in.

GEMINI_API_KEY=

# --- Recent Sermons -----------------------------------------------------------
# Both of these are OPTIONAL. The sermon list is snapshotted from YouTube's
# public RSS feed at build time (npm run build), which needs no credentials.
#
# Set a YouTube Data API v3 key only if you want the section to refresh live in
# the browser instead of at build time. See the README.
VITE_YOUTUBE_API_KEY=

# Both the build-time snapshot and live mode read the channel's "Sermons"
# playlist (PLN4ec_iMN-G0) by default.
#
# Optional, live mode only: override that with a different playlist. To read all
# channel uploads instead, use the uploads playlist ID UUGlaq1JAKKEkItED4wSj0Yw.
VITE_YOUTUBE_PLAYLIST_ID=

# Optional, build-time snapshot only (scripts/fetch-sermons.mjs): override the
# playlist, or set to an empty value to snapshot all channel uploads.
SERMONS_PLAYLIST_ID=
